# Pick one: groq (free, default) | google (free) | ollama (local) | huggingface (paid credits)
LLM_PROVIDER=groq

# Optional: override the default model for the chosen provider
# LLM_MODEL=llama-3.3-70b-versatile

# Groq: free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Google Gemini: free key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your_google_key_here

# Only needed if LLM_PROVIDER=huggingface
# HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
